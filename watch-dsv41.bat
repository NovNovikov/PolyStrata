@echo off
title record dsv41 tok_s + GPU clocks (close to stop)
echo Reads the servers own /metrics plus GPU clocks every 2 seconds.
echo Keep it open while DeepSeek generates; close the window when done.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ci=[System.Globalization.CultureInfo]::InvariantCulture; $out='L:\AI_pictures_generate\PolyStrata-data\monitor'; New-Item -ItemType Directory -Force $out > $null; $c=Join-Path $out ('dsv41-run-'+(Get-Date -f yyyyMMdd-HHmmss)+'.csv'); Write-Host \"recording to $c - close this window to stop\"; while ($true) { try { $m=(Invoke-WebRequest -UseBasicParsing http://127.0.0.1:8080/metrics -TimeoutSec 3).Content | ConvertFrom-Json; $n=((nvidia-smi --query-gpu=clocks.sm,clocks.mem,temperature.gpu,power.draw --format=csv,noheader,nounits) | Select-Object -Last 1).Trim() -replace ' ',''; (\"{0},tok={1},util={2},pcie_rx_MB={3},{4}\" -f (Get-Date -f HH:mm:ss), [math]::Round([double]$m.hardware.tok_s,1).ToString($ci), $m.hardware.gpu_util, [math]::Round([double]$m.hardware.gpu_pcie_rx_mb).ToString($ci), $n) | Add-Content $c } catch { (\"{0},server-busy\" -f (Get-Date -f HH:mm:ss)) | Add-Content $c }; Start-Sleep -Seconds 2 }"
